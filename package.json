    "format": "prettier --write ."
  },
  "keywords": [],
  "type": "module",
  "dependencies": {
    "exceljs": "^4.4.0",
    "lucide-react": "^1.45.0",
    "papaparse": "^5.7.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/node": "^24.13.4",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "prettier": "^3.9.6",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vite": "^8.3.0"
  },
  "private": true,
  "engines": {
    "node": ">=24.0.0"
  },
